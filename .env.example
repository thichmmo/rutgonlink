# Import database.sql into an empty cPanel MySQL/MariaDB database first.
# DATABASE_URL connects to that database, not directly to the .sql file.
# DB_PASSWORD is raw (Docker); DB_PASSWORD_URL_ENCODED is used inside connection URLs.
# Encode @, :, /, #, ? and % in DB_PASSWORD_URL_ENCODED.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=CHANGE_ME_CPANEL_DATABASE
DB_USER=CHANGE_ME_CPANEL_DATABASE_USER
DB_PASSWORD=CHANGE_ME_RAW_DATABASE_PASSWORD
DB_PASSWORD_URL_ENCODED=CHANGE_ME_URL_ENCODED_DATABASE_PASSWORD
DB_ROOT_PASSWORD=CHANGE_ME_DOCKER_ONLY
DATABASE_URL="mysql://CHANGE_ME_CPANEL_DATABASE_USER:CHANGE_ME_URL_ENCODED_DATABASE_PASSWORD@localhost:3306/CHANGE_ME_CPANEL_DATABASE"

# Application
NODE_ENV=production
NEXTAUTH_URL=https://rutgonlink.site
NEXTAUTH_SECRET=CHANGE_ME_RANDOM_SECRET
ENCRYPTION_KEY=CHANGE_ME_RANDOM_ENCRYPTION_KEY
ADMIN_EMAIL=CHANGE_ME_ADMIN_EMAIL
LOG_SECRET=CHANGE_ME_RANDOM_LOG_SECRET
CRON_SECRET=CHANGE_ME_RANDOM_CRON_SECRET
API_ALLOWED_HOST=rutgonlink.site
VPS_HOST=CHANGE_ME_CPANEL_SERVER_IP

# Optional integrations
FACEBOOK_APP_TOKEN=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Docker-only values
DOCKER_IMAGE=CHANGE_ME_DOCKER_IMAGE
APP_PORT=3939
